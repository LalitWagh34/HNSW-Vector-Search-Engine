# Server Port
PORT=4000

# Embedding Provider: "gemini" or "local"
EMBEDDING_PROVIDER=local

# Google Gemini API Key (get free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (for LLM generation and agent reasoning in Phase 3)
GROQ_API_KEY=

# HNSW Parameters
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=8

# Persistence Directory
DATA_DIR=./data

# PostgreSQL Database (Prisma ORM for documents, chunks, eval logs, conversations)
# Examples:
# Neon / Supabase: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local Postgres: postgresql://postgres:postgres@localhost:5432/agentic_rag?schema=public
DATABASE_URL=
