# Agent Service Port
PORT=8000

# Active LLM Provider: "groq", "gemini", or "mock" (offline test mode)
LLM_PROVIDER=mock

# Groq API Configuration (fast inference - https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (free tier - https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Node.js Retrieval Backend API URL
BACKEND_API_URL=http://localhost:4000

# LangGraph Agent Max Retries (prevents infinite loops)
MAX_RETRIES=2
